<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Panel" rgba="#202124ff"/>
    <color name="Panel2" rgba="#2b2c30ff"/>
    <color name="Text" rgba="#f1f3f4ff"/>
    <color name="Muted" rgba="#aeb4bdff"/>
    <color name="Button" rgba="#3b3d43ff"/>
    <color name="ButtonHi" rgba="#5a5e68ff"/>
  </colors>
  <gradients>
    <gradient name="ButtonGradient">
      <color-stop rgba="#474950ff" start="0"/>
      <color-stop rgba="#303239ff" start="1"/>
    </gradient>
    <gradient name="ButtonGradientHi">
      <color-stop rgba="#666a75ff" start="0"/>
      <color-stop rgba="#444750ff" start="1"/>
    </gradient>
  </gradients>
  <template name="view" class="CViewContainer" size="420, 230" minSize="420, 230" maxSize="420, 230" background-color="Panel" transparent="false">
    <view class="CTextLabel" origin="20, 18" size="380, 34" title="SMART ALIGN POST" font="~ NormalFontVeryBig" font-color="Text" text-alignment="center" transparent="true"/>
    <view class="CTextLabel" origin="30, 65" size="95, 28" title="MODE" font="~ NormalFont" font-color="Muted" text-alignment="left" transparent="true"/>
    <view class="COptionMenu" origin="130, 61" size="260, 36" control-tag="Mode" font="~ NormalFont" font-color="Text" back-color="Panel2" frame-color="Muted" frame-width="1"/>
    <view class="CTextLabel" origin="30, 108" size="360, 22" title="Reference / source selection will be added next" font="~ NormalFontSmall" font-color="Muted" text-alignment="center" transparent="true"/>
    <view class="CTextButton" origin="30, 150" size="170, 48" control-tag="Analyze" title="ANALYZE" font="~ NormalFont" text-color="Text" text-color-highlighted="Text" gradient="ButtonGradient" gradient-highlighted="ButtonGradientHi" kick-style="true" round-radius="8"/>
    <view class="CTextButton" origin="220, 150" size="170, 48" control-tag="Apply" title="APPLY" font="~ NormalFont" text-color="Text" text-color-highlighted="Text" gradient="ButtonGradient" gradient-highlighted="ButtonGradientHi" kick-style="true" round-radius="8"/>
    <view class="CTextLabel" origin="30, 205" size="360, 16" title="Windows / REAPER prototype" font="~ NormalFontSmall" font-color="Muted" text-alignment="center" transparent="true"/>
  </template>
</vstgui-ui-description>
